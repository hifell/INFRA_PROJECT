{
  "title": "Crypto Pipeline Monitoring",
  "uid": "crypto-pipeline-main",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "15s",
  "tags": ["crypto", "pipeline", "monitoring"],
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "📊 Cassandra Rows per Token",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 100},
              {"color": "green", "value": 1000}
            ]
          },
          "unit": "short",
          "displayName": "${__field.labels.token}"
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "pipeline_cassandra_rows_total",
          "legendFormat": "{{token}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "🚨 Pipeline Errors (rate/5m)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 0.1}
            ]
          },
          "unit": "ops",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(pipeline_errors_total[5m])",
          "legendFormat": "{{component}} - {{error_type}}"
        }
      ],
      "alert": {
        "name": "High Error Rate Alert",
        "conditions": [
          {
            "evaluator": {"params": [0.5], "type": "gt"},
            "operator": {"type": "and"},
            "query": {"params": ["A", "5m", "now"]},
            "reducer": {"params": [], "type": "avg"},
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "for": "3m",
        "frequency": "1m",
        "handler": 1,
        "message": "Error rate pipeline melebihi batas! Periksa komponen segera.",
        "noDataState": "no_data",
        "notifications": []
      }
    },
    {
      "id": 3,
      "title": "🎯 Sinyal Trading Terdeteksi (Total)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "options": {
        "reduceOptions": {"calcs": ["sum"]},
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": 0}
            ]
          },
          "unit": "short",
          "displayName": "Total Sinyal LONG"
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(pipeline_signal_count_total{signal_type=\"LONG\"})"
        }
      ]
    },
    {
      "id": 4,
      "title": "📡 Data Quality Score per Token",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 95}
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "percent",
          "displayName": "${__field.labels.token}"
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "pipeline_data_quality_score",
          "legendFormat": "{{token}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "⏱️ Durasi Training Model (detik)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "s",
          "custom": {"lineWidth": 2}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "pipeline_model_train_duration_seconds",
          "legendFormat": "{{token}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "📬 Alert Terkirim (Total)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
      "options": {
        "reduceOptions": {"calcs": ["sum"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "unit": "short",
          "displayName": "Alert Terkirim"
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(pipeline_alert_sent_total)"
        }
      ]
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []},
  "links": [
    {
      "title": "Airflow UI",
      "url": "http://localhost:8080",
      "type": "link",
      "icon": "external link"
    },
    {
      "title": "Spark Master UI",
      "url": "http://localhost:8081",
      "type": "link",
      "icon": "external link"
    }
  ]
}
